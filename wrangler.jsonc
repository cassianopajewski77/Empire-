// Publicação na Cloudflare.
// Os arquivos de public/ são servidos direto. Só as rotas /api/* passam pelo
// servidor (src/worker.js), que cria e consulta os pagamentos Pix no Mercado Pago.
// O token do Mercado Pago é um segredo (MP_ACCESS_TOKEN) cadastrado no painel da
// Cloudflare em Settings → Variables and Secrets. Nunca coloque o token aqui.
{
  "name": "empire",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
