{
  "name": "empire",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Banco de pedidos: Durable Object com SQLite (plano gratuito). Não precisa criar nada no painel.
  "durable_objects": { "bindings": [{ "name": "PEDIDOS", "class_name": "Pedidos" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pedidos"] }],
  "observability": { "enabled": true }
}
